<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Datide Inventory</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #f4f6f9; }
        .navbar-brand { font-weight: 700; }
        .card { box-shadow: 0 1px 3px rgba(0,0,0,.08); border: none; }
        .table thead th { font-size: .8rem; text-transform: uppercase; letter-spacing: .4px; color: #6c757d; }
        .badge-low { background: #fee2e2; color: #b91c1c; }
        .badge-ok { background: #dcfce7; color: #15803d; }
        .badge-pending { background: #fef9c3; color: #a16207; }
        .badge-approved { background: #dcfce7; color: #15803d; }
        .badge-rejected { background: #fee2e2; color: #b91c1c; }
        .kpi-card .display-6 { font-weight: 700; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid px-4">
            <a class="navbar-brand" asp-page="/Index"><i class="bi bi-box-seam me-2"></i>Datide Inventory</a>
            @{
                var currentPath = Context.Request.Path + Context.Request.QueryString;
                var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
            }
            <ul class="navbar-nav ms-auto order-lg-3">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" title="@Localizer["Language"]">
                        <i class="bi bi-translate me-1"></i>
                        @(currentCulture == "zh-Hant" ? "繁體中文"
                          : currentCulture == "zh-Hans" ? "简体中文"
                          : "English")
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item @(currentCulture == "en" ? "active" : "")"
                               href="/set-language?culture=en&returnUrl=@Uri.EscapeDataString(currentPath)">English</a></li>
                        <li><a class="dropdown-item @(currentCulture == "zh-Hant" ? "active" : "")"
                               href="/set-language?culture=zh-Hant&returnUrl=@Uri.EscapeDataString(currentPath)">繁體中文</a></li>
                        <li><a class="dropdown-item @(currentCulture == "zh-Hans" ? "active" : "")"
                               href="/set-language?culture=zh-Hans&returnUrl=@Uri.EscapeDataString(currentPath)">简体中文</a></li>
                    </ul>
                </li>
            </ul>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="navbar-toggler order-lg-4" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse order-lg-2" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">@Localizer["Dashboard"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Skus/Index">@Localizer["SKUs"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/PurchaseOrders/Index">@Localizer["Purchase Orders"]</a></li>
                    @if (User.IsInRole("Manager"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/PurchaseOrders/Approvals">@Localizer["Approvals"]</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form method="post" asp-page="/Account/Logout">
                                    <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2"></i>@Localizer["Log out"]</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
                </div>
            }
        </div>
    </nav>

    <main class="container-fluid px-4 py-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
