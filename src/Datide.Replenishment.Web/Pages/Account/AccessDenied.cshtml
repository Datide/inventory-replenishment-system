@page
@{
    ViewData["Title"] = @Localizer["Access denied"];
}

<div class="text-center mt-5">
    <i class="bi bi-shield-lock display-3 text-danger"></i>
    <h3 class="mt-3">@Localizer["Access denied"]</h3>
    <p class="text-muted">@Localizer["You do not have permission to view this page."]</p>
    <a class="btn btn-primary" asp-page="/Index">@Localizer["Back to Dashboard"]</a>
</div>
