@page
@model Datide.Replenishment.Web.Pages.Skus.CreateModel
@{
    ViewData["Title"] = @Localizer["New SKU"];
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card"><div class="card-body p-4">
            <h1 class="h4 mb-4">@Localizer["New SKU"]</h1>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label small fw-semibold"></label>
                    <input asp-for="Code" class="form-control" placeholder="@Localizer["e.g. SKU-1006"]" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-semibold"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="UnitPrice" class="form-label small fw-semibold"></label>
                        <input asp-for="UnitPrice" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="ReorderPoint" class="form-label small fw-semibold"></label>
                        <input asp-for="ReorderPoint" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="MaxStock" class="form-label small fw-semibold"></label>
                        <input asp-for="MaxStock" class="form-control" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
                    <a class="btn btn-outline-secondary" asp-page="Index">@Localizer["Cancel"]</a>
                </div>
            </form>
        </div></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
