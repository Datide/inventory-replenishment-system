@page
@model Datide.Replenishment.Web.Pages.PurchaseOrders.ExportModel
@{
    ViewData["Title"] = @Localizer["Export"];
}

<div class="text-center mt-5">
    <i class="bi bi-file-earmark-excel display-3 text-success"></i>
    <h3 class="mt-3">@Localizer["Export database to Excel"]</h3>
    <p class="text-muted">@Localizer["Downloads an .xlsx workbook with one sheet per table (SKUs, Users, Stock Snapshots, Purchase Orders)."]</p>
    <a class="btn btn-success btn-lg mt-2" asp-page-handler="Download">
        <i class="bi bi-download me-2"></i>@Localizer["Download datide_export.xlsx"]
    </a>
</div>
